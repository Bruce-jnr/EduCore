DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/edupalgh"
PORT=8080
CLIENT_URL="http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-secret"
# Google OAuth Web application client ID (public identifier; no client secret required)
GOOGLE_CLIENT_ID=
JWT_EXPIRES_IN="15m"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=2097152
SEED_ADMIN_EMAIL="admin@demo.edupalgh.local"
SEED_ADMIN_PASSWORD="replace-with-a-development-password"
PLATFORM_ADMIN_EMAIL="platform@edupalgh.local"
PLATFORM_ADMIN_PASSWORD="replace-with-a-platform-development-password"

# Paystack hosted checkout. Existing PAYSTACK_LIVE_SECRET_KEY / PAYSTACK_TEST_SECRET_KEY aliases are supported.
# Keep secret keys on the API server; hosted checkout does not require a browser public key.
PAYSTACK_SECRET_KEY=
# Public HTTPS API origin in production, e.g. https://api.your-domain.example
PUBLIC_API_URL=
